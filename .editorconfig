# custos editor rules. Read by VS Code (EditorConfig extension) and most editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break; keep them.
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
